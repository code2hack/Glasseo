{
  "name": "glasseo",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test web/test/*.test.ts",
