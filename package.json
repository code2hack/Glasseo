    "@getpaseo/relay": "0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.0",
    "eslint": "10.9.1",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0"
  }
}
